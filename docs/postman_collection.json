{
  "info": {
    "name": "Library Management System API",
    "description": "Requests for authentication, profile, genres, and books. Set baseUrl, librarianToken, and patronToken in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "bookId", "value": "" },
    { "key": "genreId", "value": "" },
    { "key": "librarianToken", "value": "" },
    { "key": "patronToken", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        { "name": "Register patron", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Patron\",\n  \"email\": \"patron@example.com\",\n  \"password\": \"StrongPass123!\"\n}" }, "url": "{{baseUrl}}/auth/register" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('patronToken', pm.response.json().accessToken);"] } }] },
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"replace-with-your-seeded-password\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('librarianToken', pm.response.json().accessToken);"] } }] },
        { "name": "Get my profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patronToken}}" }], "url": "{{baseUrl}}/users/profile" } }
      ]
    },
    {
      "name": "Genres",
      "item": [
        { "name": "List genres", "request": { "method": "GET", "url": "{{baseUrl}}/genres" } },
        { "name": "Get genre", "request": { "method": "GET", "url": "{{baseUrl}}/genres/{{genreId}}" } },
        { "name": "Create genre", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Biography\"\n}" }, "url": "{{baseUrl}}/genres" } },
        { "name": "Update genre", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Biographies\"\n}" }, "url": "{{baseUrl}}/genres/{{genreId}}" } },
        { "name": "Delete genre", "request": { "method": "DELETE", "url": "{{baseUrl}}/genres/{{genreId}}" } }
      ]
    },
    {
      "name": "Books",
      "item": [
        { "name": "List books with filters and pagination", "request": { "method": "GET", "url": "{{baseUrl}}/books?genreId={{genreId}}&search=history&page=1&limit=10" } },
        { "name": "Get book", "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" } },
        { "name": "Create book (librarian)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{librarianToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Example Book\",\n  \"author\": \"Example Author\",\n  \"isbn\": \"EXAMPLE-ISBN-001\",\n  \"totalCopies\": 5,\n  \"genreId\": \"{{genreId}}\"\n}" }, "url": "{{baseUrl}}/books" } },
        { "name": "Update book (librarian)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{librarianToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"totalCopies\": 8\n}" }, "url": "{{baseUrl}}/books/{{bookId}}" } },
        { "name": "Delete book (librarian)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{librarianToken}}" }], "url": "{{baseUrl}}/books/{{bookId}}" } }
      ]
    }
  ]
}